  {
    "version": 6,
    "configurePresets": [
      {
        "name": "adv-debug",
        "displayName": "Advance Debug",
        "generator": "Ninja",
        "binaryDir": "${sourceDir}/../build",
        "cacheVariables": {
          "ADV": "true",
          "CMAKE_BUILD_TYPE": "Debug"
        }
      },
      {
        "name": "adv-release",
        "displayName": "Advance Release",
        "generator": "Ninja",
        "binaryDir": "${sourceDir}/../build-opt",
        "cacheVariables": {
          "ADV": "true",
          "CMAKE_BUILD_TYPE": "Release"
        }
      },
      {
        "name": "picoseq-debug",
        "displayName": "picoSeq Debug (SEQ_MIDI_ONLY)",
        "generator": "Ninja",
        "binaryDir": "${sourceDir}/../build-picoseq",
        "cacheVariables": {
          "ADV": "true",
          "CMAKE_BUILD_TYPE": "Debug",
          "SEQ_MIDI_ONLY": "ON",
          "ENABLE_LOGGING": "ON"
        }
      }
    ],
        "buildPresets": [
      {
        "name": "adv-debug",
        "configurePreset": "adv-debug",
        "jobs": 16
      },
      {
        "name": "adv-release",
        "configurePreset": "adv-release",
        "jobs": 16
      },
      {
        "name": "picoseq-debug",
        "configurePreset": "picoseq-debug",
        "jobs": 16
      }
    ]
  }
